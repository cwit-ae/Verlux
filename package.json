{
  "name": "verlux",
  "version": "1.0.15",
  "description": "Profanity and abuse detection across 5 languages with severity, category, and toxicity scoring per match. Unicode-obfuscation resistant, zero dependencies, fully offline.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "NOTICES"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "profanity",
    "filter",
    "abuse",
    "detection",
    "multilingual",
    "fuzzy",
    "transliteration",
    "hinglish",
    "moderation",
    "content-filter",
    "unicode",
    "confusables",
    "homoglyph",
    "obfuscation",
    "nfkc"
  ],
  "author": "Bilal Subhani - CWIT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwit-ae/verlux.git"
  },
  "bugs": {
    "url": "https://github.com/cwit-ae/verlux/issues"
  },
  "homepage": "https://github.com/cwit-ae/verlux#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  }
}
